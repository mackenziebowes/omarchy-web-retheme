{
  "manifest_version": 3,
  "name": "Omarchy Web Retheme",
  "version": "0.1.0",
  "description": "Restyles websites with your current Omarchy theme.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "css.js",
        "paint.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omarchy Web Retheme"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-web-retheme@mackenziebowes.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
